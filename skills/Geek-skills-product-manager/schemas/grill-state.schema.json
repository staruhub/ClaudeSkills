{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staruhub.github.io/ClaudeSkills/schemas/grill-state.schema.json",
  "title": "Grill-me-to-doc session state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "skill_version",
    "mode",
    "status",
    "evidence",
    "decision_log",
    "unresolved_questions",
    "completion_gate",
    "product_doc",
    "hard_stop"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,63}$"},
    "skill_version": {"const": "1.2.0"},
    "mode": {"const": "grill-me-to-doc"},
    "status": {
      "enum": [
        "evidence-gathering",
        "interviewing",
        "ready-for-draft",
        "awaiting-approval",
        "approved",
        "stopped"
      ]
    },
    "next_question_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "summary", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "summary": {"type": "string", "minLength": 1},
          "kind": {"enum": ["fact", "constraint", "evidence_unavailable"]}
        }
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "rationale", "source", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^d-[a-z0-9-]+$"},
          "question_id": {"type": ["string", "null"]},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "source": {"enum": ["repository", "user", "inference"]},
          "status": {"enum": ["accepted", "modified", "rejected"]}
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^q-[a-z0-9-]+$"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "completion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "users_jtbd",
        "evidence_assumptions",
        "scope_non_goals",
        "flows",
        "requirements",
        "success_metrics",
        "risks",
        "open_questions",
        "acceptance_criteria"
      ],
      "properties": {
        "problem": {"type": "boolean"},
        "users_jtbd": {"type": "boolean"},
        "evidence_assumptions": {"type": "boolean"},
        "scope_non_goals": {"type": "boolean"},
        "flows": {"type": "boolean"},
        "requirements": {"type": "boolean"},
        "success_metrics": {"type": "boolean"},
        "risks": {"type": "boolean"},
        "open_questions": {"type": "boolean"},
        "acceptance_criteria": {"type": "boolean"}
      }
    },
    "product_doc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_path", "final_path", "approved_by_user"],
      "properties": {
        "draft_path": {"type": ["string", "null"]},
        "final_path": {"type": ["string", "null"]},
        "approved_by_user": {"type": "boolean"},
        "approved_at_event": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "hard_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_allowed", "reason"],
      "properties": {
        "implementation_allowed": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["ready-for-draft", "awaiting-approval", "approved", "stopped"]}
        }
      },
      "then": {
        "properties": {
          "completion_gate": {
            "properties": {
              "problem": {"const": true},
              "users_jtbd": {"const": true},
              "evidence_assumptions": {"const": true},
              "scope_non_goals": {"const": true},
              "flows": {"const": true},
              "requirements": {"const": true},
              "success_metrics": {"const": true},
              "risks": {"const": true},
              "open_questions": {"const": true},
              "acceptance_criteria": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["approved", "stopped"]}}},
      "then": {
        "properties": {
          "product_doc": {
            "properties": {
              "approved_by_user": {"const": true},
              "final_path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
